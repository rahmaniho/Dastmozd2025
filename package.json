{
  "name": "dastmozd-armani",
  "version": "1.0.0",
  "private": true,
  "description": "دستمزد آرمانی ۱۴۰۵ — سامانه جامع حقوق و دستمزد (PWA + Windows)",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "brand:icons": "node packages/brand/scripts/generate-icons.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
