{
  "name": "@dastmozd/types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "انواع داده‌ای مشترک سامانه دستمزد آرمانی",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declarationMap false --outDir .tscheck",
    "clean": "rm -rf dist .tscheck .turbo",
    "lint": "eslint src"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
