{
  "name": "@dastmozd/legal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "پروفایل‌های سالانه قوانین کار، تأمین اجتماعی و مالیات (۱۴۰۳ تا ۱۴۰۵)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@dastmozd/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
